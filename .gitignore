# Patterns deliberately UNANCHORED, so that they bite at every level.
# A leading slash would no longer match in a new subproject.

node_modules/
.pnpm-store/
dist/
build/
out/
.next/
.next-production/
.astro/
*.tsbuildinfo
next-env.d.ts

# Memory images of a crashed process. The one at the root is anchored on purpose:
# an unanchored `core` would also hide a folder of that name.
core.[0-9]*
/core

# Coverage
coverage/
.nyc_output/

# Rust, in case a subproject appears somewhere
target/

# Environment and state
.env
.env.*
!.env.example
*.log
npm-debug.log*
pnpm-debug.log*

# Editor and operating system
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo
*~

.local/
playwright-report/
test-results/
