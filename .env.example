# Production/staging configuration. Local Docker generates .env.development.
# compose.production.yaml with the profile `bundled` also needs POSTGRES_PASSWORD, and it
# builds DATABASE_URL and S3_ENDPOINT itself unless they are set here.
APP_URL=https://support.example.com
DATABASE_URL=postgresql://user:password@database.example.com/aidesk
# For a platform with many short-lived instances behind a pooler in transaction mode:
# DATABASE_POOL_MAX=1 and DATABASE_PREPARE=false. Empty means the defaults (10, true).
DATABASE_POOL_MAX=
DATABASE_PREPARE=
BETTER_AUTH_SECRET=
ENCRYPTION_KEY=
# Only while the keys are rotated: the old values, and the number of the secret (raised by one with each rotation).
# See "Rotating the keys" in docs/development.md.
ENCRYPTION_KEY_PREVIOUS=
BETTER_AUTH_SECRET_PREVIOUS=
BETTER_AUTH_SECRET_VERSION=
S3_ENDPOINT=https://objects.example.com
S3_REGION=us-east-1
S3_BUCKET=aidesk
S3_ACCESS_KEY=
S3_SECRET_KEY=
# One-time secret for claiming the first owner at /setup (32+ characters).
# Remove it once the owner exists.
OWNER_CLAIM_TOKEN=
# Lets an owner who lost the password set a new one at /recover (32 characters or more). It can stay set.
OWNER_RECOVERY_TOKEN=
# DEV_BOOTSTRAP must remain false outside private local development.
DEV_BOOTSTRAP=false
