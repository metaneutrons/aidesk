{
  "name": "@metaneutrons/aidesk",
  "version": "0.8.0",
  "private": true,
  "type": "module",
  "license": "GPL-3.0-or-later",
  "author": "metaneutrons",
  "repository": {
    "type": "git",
    "url": "https://github.com/metaneutrons/aidesk.git"
  },
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=26 <27"
  },
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "check:catalogs": "tsx scripts/check-catalogs.ts",
    "api:docs": "tsx scripts/api-docs.ts",
    "check:gates": "node scripts/verify-gates.mjs",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate.ts",
    "dev:seed": "tsx scripts/seed.ts",
    "worker": "tsx src/worker/index.ts",
    "dev:docker": "sh scripts/dev.sh up",
    "dev:stop": "sh scripts/dev.sh down",
    "prepare": "node scripts/install-hooks.mjs",
    "format": "prettier --write src scripts/*.ts tests",
    "format:check": "prettier --check src scripts/*.ts tests"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "4.0.98",
    "@ai-sdk/google": "4.0.113",
    "@ai-sdk/openai": "4.0.110",
    "@aws-sdk/client-s3": "3.1164.0",
    "@base-ui/react": "1.9.0",
    "@better-auth/passkey": "1.7.18",
    "@better-auth/sso": "1.7.18",
    "@modelcontextprotocol/sdk": "1.32.2",
    "@react-email/render": "2.2.0",
    "@simplewebauthn/browser": "^14.0.0",
    "ai": "7.0.164",
    "better-auth": "1.7.18",
    "drizzle-orm": "0.45.4",
    "esbuild": "0.28.2",
    "fflate": "0.8.3",
    "imapflow": "2.11.0",
    "lucide-react": "1.70.0",
    "mailparser": "3.14.2",
    "marked": "18.1.3",
    "next": "16.4.5",
    "next-intl": "4.14.9",
    "nodemailer": "10.3.1",
    "pdfjs-dist": "6.5.438",
    "postgres": "3.4.9",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sanitize-html": "2.18.1",
    "smtp-server": "3.21.3",
    "tsx": "4.23.15",
    "turndown": "7.2.5",
    "uqr": "^0.1.3",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@apidevtools/swagger-parser": "^13.1.0",
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.65.0",
    "@tailwindcss/postcss": "4.3.5",
    "@types/mailparser": "3.9.0",
    "@types/node": "26.6.6",
    "@types/nodemailer": "8.0.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/sanitize-html": "2.16.2",
    "@types/smtp-server": "3.5.13",
    "@types/turndown": "5.0.6",
    "@vitest/coverage-v8": "5.1.0",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "drizzle-kit": "0.31.11",
    "eslint": "10.14.0",
    "jsqr": "^1.4.0",
    "lefthook": "2.2.2",
    "prettier": "3.9.10",
    "tailwindcss": "4.3.5",
    "typescript": "~6.0.3",
    "typescript-eslint": "8.72.1",
    "vitest": "5.1.0"
  }
}
